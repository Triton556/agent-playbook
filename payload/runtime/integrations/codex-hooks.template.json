{
  "description": "Local knowledge capture by the current agent; the designated curator performs daily synchronization.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{MEMORY_ROOT}}/SYSTEM/scripts/kb.mjs\" hook",
            "commandWindows": "\"{{NODE}}\" \"{{MEMORY_ROOT}}/SYSTEM/scripts/kb.mjs\" hook",
            "timeout": 10,
            "additionalContextLimit": 800,
            "statusMessage": "Preparing local memory capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{MEMORY_ROOT}}/SYSTEM/scripts/kb.mjs\" hook",
            "commandWindows": "\"{{NODE}}\" \"{{MEMORY_ROOT}}/SYSTEM/scripts/kb.mjs\" hook",
            "timeout": 10,
            "statusMessage": "Checking local memory persistence"
          }
        ]
      }
    ]
  }
}
